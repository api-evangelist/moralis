                ":address",
                "erc20"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "chain",
                  "value": "eth",
                  "description": "The chain to query"
                },
                {
                  "disabled": false,
                  "key": "to_block",
                  "value": "<number>",
                  "description": "The block number up to which the balances will be checked."
                },
                {
                  "disabled": false,
                  "key": "token_addresses",
                  "value": "<string>",
                  "description": "The addresses to get balances for (optional)"
